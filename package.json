{
  "name": "better-t-stack",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/fs-extra": "^11.0.4",
      "@types/node": "^26.6.7",
      "better-result": "^3.0.1",
      "handlebars": "^4.7.10",
      "oxfmt": "^0.80.0",
      "ts-morph": "^28.0.0",
      "tsdown": "^0.23.7",
      "typescript": "^7.0.2",
      "yaml": "^2.9.1",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:cli": "turbo run dev --filter=create-better-tanstacked",
    "cli": "cd apps/cli && node dist/cli.mjs",
    "smoke:publish": "bun run scripts/publish-smoke.ts",
    "build:cli": "turbo run build --filter=create-better-tanstacked",
    "test": "bun run check && cd apps/cli && bun test",
    "test:complete": "bun run check && bun run build && cd apps/cli && BTS_MATRIX_MODE=smoke BTS_BUILD_SAMPLES=1 bun test --bail=5",
    "lint": "turbo run lint",
    "check": "oxfmt . && oxlint .",
    "prepare": "lefthook install",
    "release": "bun run scripts/release.ts",
    "bump": "bun run scripts/bump-version.ts",
    "canary": "bun run scripts/canary-release.ts",
    "smoke:docker": "bash scripts/docker-smoke.sh",
    "smoke:vercel": "bash scripts/vercel-smoke.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.95.0",
    "@types/bun": "^1.4.5",
    "changelogithub": "^15.0.5",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.2",
    "oxfmt": "catalog:",
    "oxlint": "1.95.0",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": [
      "bun check"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.2"
}
