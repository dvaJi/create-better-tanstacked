{
  "name": "web",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
{{#unless (eq webDeploy "cloudflare")}}
    "build": "{{#if (and (eq api "orpc") (ne backend "convex") (ne backend "none"))}}tsc -b ../../packages/api && {{/if}}astro build",

{{/unless}}
		"check-types": "{{#if (and (eq api "orpc") (ne backend "convex") (ne backend "none"))}}tsc -b ../../packages/api && {{/if}}astro check",
{{#unless (eq webDeploy "cloudflare")}}
    "preview": "astro preview",
{{/unless}}
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
		"@astrojs/check": "^0.9.10",
{{#unless (or (includes addons "electrobun") (includes addons "tauri"))}}
{{#if (eq webDeploy "vercel")}}
    "@astrojs/vercel": "^11.0.11",
{{else if (eq webDeploy "cloudflare")}}
    "@astrojs/cloudflare": "^14.3.3",
    "wrangler": "^4.147.0",
{{else}}
    "@astrojs/node": "^11.1.6",
{{/if}}
{{/unless}}
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
